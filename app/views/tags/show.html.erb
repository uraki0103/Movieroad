<div class="max-w-5xl mx-auto mt-6 px-4 py-6" data-controller="tag-tabs">
  <div class="flex items-center gap-2 mb-6">
    <%= link_to mypage_path, class: "text-stone-500 hover:text-stone-900" do %>
      <i class="ti ti-arrow-left text-xl"></i>
    <% end %>
    <h1 class="text-lg font-semibold text-stone-900">タグ管理</h1>
  </div>

  <div class="flex gap-2 mb-6 md:hidden">
    <button type="button" data-action="tag-tabs#show" data-tag-tabs-target-param="theater"
        class="flex-1 py-2 rounded-md text-sm font-medium bg-amber-900 text-white">
      観賞場所
    </button>
    <button type="button" data-action="tag-tabs#show" data-tag-tabs-target-param="companion"
        class="flex-1 py-2 rounded-md text-sm font-medium bg-amber-900 text-white">
      観た人
    </button>
  </div>

  <div class="grid md:grid-cols-2 md:gap-8">
    <div data-tag-tabs-target="theaterPanel">
      <p class="text-base font-semibold text-stone-800 mb-4 hidden md:block">劇場</p>
      <% if @theaters.empty? %>
        <p class="text-sm text-stone-400 py-4">登録されている観賞場所タグはありません</p>
      <% else %>
        <div class="space-y-1 border-t border-stone-400">
          <% @theaters.each do |theater| %>
            <div class="flex items-center justify-between py-2 border-b border-stone-100">
              <span class="text-sm text-stone-900"><%= theater.theater_name %><span class="text-stone-400 text-xs">・<%= theater.records_count %>件</span></span>
              <%= button_to tags_theater_path(theater), method: :delete,
                  class: "text-stone-400 hover:text-red-700 bg-transparent border-none cursor-pointer",
                  form: { data: { turbo_confirm: " 「#{theater.theater_name}」を削除しますか？"} } do %>
                <i class="ti ti-trash text-sm"></i>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <div data-tag-tabs-target="companionPanel" class="hidden md:block">
      <p class="text-base font-semibold text-stone-800 mb-4 hidden md:block">観た人</p>
      <% if @companions.empty? %>
        <p class="text-sm text-stone-400 py-4">登録されている観た人タグはありません</p>
      <% else %>
        <div class="space-y-1 border-t border-stone-400">
          <% @companions.each do |companion| %>
            <div class="flex items-center justify-between py-2 border-b border-stone-100">
              <span class="text-sm text-stone-900"><%= companion.companion_name %><span class="text-stone-400 text-xs">・<%= companion.records_count %>件</span></span>
              <%= button_to tags_companion_path(companion), method: :delete,
                  class: "text-stone-400 hover:text-red-700 bg-transparent border-none cursor-pointer",
                  form: { data: { turbo_confirm: " 「#{companion.companion_name}」を削除しますか？"} } do %>
                <i class="ti ti-trash text-sm"></i>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
