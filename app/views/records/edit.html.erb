<div class="max-w-md md:max-w-5xl mx-auto mt-10 bg-white border border-stone-200 rounded-lg p-8" data-controller="movie-search">
  <div class="mb-6 flex flex-col">
    <%= link_to "← タイムラインに戻る" , records_path, class: "text-sm text-stone-600 hover:text-stone-900"%>
    <%= link_to "← 記録詳細に戻る" , record_path(@record), class: "text-sm text-stone-600 hover:text-stone-900"%>
  </div>
  <h2 class="text-2xl font-semibold text-stone-900 mb-6">編集</h2>

  <%= form_with model: @record, url: record_path(@record), id: "record_edit_form" do |f| %>
    <%= render "shared/form", record: @record, f: f %>
  <% end %>

  <% if @record.memory_photos.attached? %>
    <div class="flex flex-wrap gap-2 mt-3">
      <% @record.memory_photos.each do |photo| %>
        <%= render "shared/memory_photo", photo: photo, record: @record %>
      <% end %>
    </div>
  <% end %>
  
  <div class="flex justify-center mt-8">
    <%= render "shared/submit", label: "更新する", form_id: "record_edit_form" %>
  </div>
  
  <%= render "shared/movie_search_modal" %>
</div>