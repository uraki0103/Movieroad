<div class="max-w-md md:max-w-2xl mx-auto mt-10 bg-white border border-stone-200 rounded-lg p-8">
  <div class="mb-6 flex flex-col">
    <%= link_to "← タイムラインに戻る" , records_path, class: "text-sm text-stone-600 hover:text-stone-900"%>
    <%= link_to "← 記録詳細に戻る" , record_path(@record), class: "text-sm text-stone-600 hover:text-stone-900"%>
  </div>
  <h2 class="text-2xl font-semibold text-stone-900 mb-6">編集</h2>
  <%= render "shared/form", record: @record, url: record_path(@record), submit_label: "更新する" %>
</div>