<div class="max-w-5xl mx-auto bg-white border border-stone-200 rounded-lg p-8"> 
  <div class="flex items-center justify-between mb-6">
    <%= link_to "← タイムラインに戻る", records_path, class: "text-sm text-stone-600 hover:text-stone-900" %>
    <div class="flex items-center gap-2">
      <%= link_to "編集する", edit_record_path(@record), class: "text-sm font-medium text-white bg-amber-900 px-4 py-2 rounded-md hover:bg-amber-700 transition-colors" %>
      <%= button_to "削除する", record_path(@record), method: :delete,
          class: "text-sm font-medium text-white bg-amber-900 px-4 py-2 rounded-md hover:bg-amber-700 transition-colors",
          form: { data: { turbo_confirm: "この記録を削除しますか？" } } %>
    </div>
  </div>

  <div class="flex flex-col md:flex-row justify-between gap-4 mb-4">
    <div class="flex-1">
      <h2 class="text-2xl font-semibold text-stone-900 mb-2 border-b border-stone-200 pt-4 mt-4"><%= @record.movie.title %></h2>
      <div class="flex items-center gap-4 pt-4 mb-2">
        <span class="text-xl font-semibold text-amber-900"><%= @record.rating %></span>
        <p class="text-sm text-stone-600"><%= @record.watched_day.strftime("%Y/%m/%d") %></p>
      </div>
    </div>
    <% if @record.movie.poster_url.present? %>
      <%= image_tag @record.movie.poster_url, class: "w-full max-w-60 md:w-60 md:h-84 mx-auto md:mx-0 object-cover rounded-md border border-stone-200 flex-shrink-0" %>
    <% else %>
      <div class="w-60 h-84 bg-stone-100 rounded-md border border-stone-200 flex items-center justify-center text-stone-300 text-xs flex-shrink-0">
        No image 
      </div>
    <% end %>
  </div>
  

  <% if @record.impression.present? %>
    <div class="border-t border-stone-200 pt-4 mt-4">
      <p class="text-sm text-stone-500 mb-2">感想</p>
      <p class="text-sm text-stone-900 whitespace-pre-wrap leading-relaxed"><%= @record.impression %></p>
    </div>
  <% end %>

  <% if @record.theater.present? %>
    <div class="border-t border-stone-200 pt-4 mt-4">
      <p class="text-sm text-stone-500 mb-2">観賞場所</p>
      <span class="inline-flex items-center gap-1 bg-amber-50 text-amber-900 text-sm px-3 py-1 rounded-full">
        <%= @record.theater.theater_name %>
      </span>
    </div>
  <% end %>

  <% if @record.companions.any? %>
    <div class="border-t border-stone-200 pt-4 mt-4">
      <p class="text-sm text-stone-500 mb-2">観た人</p>
      <div class="flex flex-wrap gap-2">
        <% @record.companions.each do |companion| %>
          <span class="inline-flex items-center gap-1 bg-amber-50 text-amber-900 text-sm px-3 py-1 rounded-full">
            <%= companion.companion_name %>
          </span>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @record.memory_note.present? || @record.memory_photos.attached? %>
    <div class="border-t border-stone-200 pt-4 mt-4"
      data-controller="photo-slider"
      data-photo-slider-urls-value="<%= @record.memory_photos.map { |p| url_for(p) }.to_json %>">
      <p class="text-sm text-stone-500 mb-2">思い出</p>    
      <% if @record.memory_note.present? %>
        <p class="text-sm text-stone-900 whitespace-pre-wrap leading-relaxed"><%= @record.memory_note %></p>
      <% end %>
      <% if @record.memory_photos.attached? %>
        <div class="flex flex-wrap gap-2">
          <% @record.memory_photos.each_with_index do |photo, index| %>
            <button type="button" data-action="photo-slider#open" data-photo-slider-index-param="<%= index %>">
              <%= image_tag photo, class: "w-50 h-50 object-cover rounded-md border border-stone-200 hover:opacity-80 transition-opacity" %>
            </button>
          <% end %>
        </div>
      <% end %>

      <div data-photo-slider-target="modal"
          data-action="click->photo-slider#closeOnBackground"
          class="hidden fixed inset-0 bg-black/90 z-50 flex items-center justify-center p-4">
        <button type="button" data-action="photo-slider#close"
            class="absolute top-4 right-4 text-white text-2xl hover:opacity-70">×</button>

        <button type="button" data-action="photo-slider#prev"
            class="absolute left-4 text-white text-3xl hover:opacity-70">‹</button>

        <img data-photo-slider-target="image" class="max-w-full max-h-full object-contain">

        <button type="button" data-action="photo-slider#next"
            class="absolute right-4 text-white text-3xl hover:opacity-70">›</button>

        <p data-photo-slider-target="counter"
            class="absolute bottom-4 text-white text-sm bg-black/50 px-3 py-1 rounded-full"></p>
      </div>
    </div>
  <% end %>
</div>