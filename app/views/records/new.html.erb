<div class="max-w-md md:max-w-5xl mx-auto mt-10 bg-white border border-stone-200 rounded-lg p-8" data-controller="movie-search">
  <h2 class="text-2xl font-semibold text-stone-900 mb-6">新規作成</h2>
  
  <%= form_with model: @record, url: records_path, id: "record_form" do |f| %>
    <%= render "shared/form", record: @record, f: f %>
  <% end %>
  
  <div class="flex justify-center mt-8">
    <%= render "shared/submit", label: "作成", form_id: "record_form" %>
  </div>

  <%= render "shared/movie_search_modal" %>
</div>