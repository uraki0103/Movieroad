<div class="max-w-md md:max-w-5xl mx-auto mt-10 bg-white border border-stone-200 rounded-lg p-8">
  <h1>タイムライン<h1>

  <p>仮の画面です</p>

  <%= link_to "新規作成仮リンク", new_record_path %>

  <% @records_by_year.each do |year, records| %>
    <p><%= year %>年</p>
    <% records.each do |record| %>
      <div class= "flex flex-col">
        <%= link_to record_path(record) do %>
          <%= record.movie.title  %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>


