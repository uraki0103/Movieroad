<div class="">
  <h1>タイムライン<h1>

  <p>仮の画面です</p>

  <%= link_to "新規作成仮リンク", new_record_path %>

  <% @records_by_year.each do |year, records| %>
    <p><%= year %>年</p>
    <% records.each do |record| %>
      <%= link_to record_path(record) do %>
        <%= record.movie.title  %>
      <% end %>
    <% end %>
  <% end %>
</div>


