<div class="max-w-md md:max-w-5xl mx-auto mt-6 px-4 py-2">
  <div class="flex items-center justify-between mb-8 ">
    <h1 class="text-lg font-semibold text-stone-900">MovieRoad</h1>
    <%= link_to "＋記録を作成する", new_record_path, class: "text-sm font-medium text-white bg-amber-900 px-4 py-2 rounded-md hover:bg-amber-700 transition-colors" %>
  </div>
  
  <% if @records_by_year.blank? %>
    <div class="text-center py-20 text-stone-400 text-md">
      記録がありません。<br>
      右上から最初の一歩を記録しよう！
    </div>
  <% else %>
    <% @records_by_year.each_with_index do |(year, records), year_index| %>
      <details <%= "open" if year_index.zero? %> class="mb-2">
        <summary class="cursor-pointer py-3 border-b border-stone-200 flex items-center justify-between list-none">
          <span class="text-sm font-medium text-stone-900">
            <%= year %>年 <span class="text-stone-400 font-normal">（<%= records.size %>本）</span>
          </span>
          <i class="ti ti-chevron-down text-stone-900"></i>
        </summary>
  

        <div class="relative py-4">
          <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-px bg-stone-200 -translate-x-1/2"></div>
          <div class="md:hidden absolute left-5 top-4 bottom-4 w-px bg-stone-200"></div>

          <% records.each_with_index do |record, index| %>
            <div class="relative mb-6 last:mb-0">
              <div class="flex gap-3 md:hidden pl-10 relative">
                <span class="absolute left-4 top-6 w-2.5 h-2.5 rounded-full bg-amber-900 border-2 border-white"></span>
                <%= render "shared/record_card", record: record %>
              </div>

              <div class="hidden md:grid md:grid-cols-[1fr_24px_1fr] md:items-center">
                <% if index.even? %>
                  <div class="text-right pr-4"><%= render "shared/record_card", record: record %></div>
                  <div class="flex justify-center"><span class="w-2.5 h-2.5 rounded-full bg-amber-900 border-2 border-white"></span>
                  <div></div>
                <% else %>
                  <div></div>
                  <div class="flex justify-center"><span class="w-2.5 h-2.5 rounded-full bg-amber-900 border-2 border-white"></div>
                  <div class="pl-4"><%= render "shared/record_card", record: record %></div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </details>
    <% end %>
  <% end %>
</div>


