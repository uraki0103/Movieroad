<% if @record.errors.any? %>
  <div class="mb-4 bg-red-50 text-red-900 text-sm rounded-md p-3">
    <p class="font-midium mb-1">
      <%= t("errors.messages.not_saved", count: @record.errors.count, resource: @record.class.model_name.human.downcase) %>
    </p>
    <ul class="list-disc list-inside">
      <% @record.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: record, url: url do |f| %>
	<div class="mb-4">
		<%= label_tag "record_movie_title", "映画タイトル", class:"block text-sm text-stone-600 mb-1" %>
		<%= text_field_tag "record[movie_title]", @record.movie&.title, 
			  class:"w-full border border-stone-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-amber-900" %>
	</div>

	<div class="mb-4">
		<%= f.label :rating , "評価", class: "block text-sm text-stone-600 mb-1"%>
		<div class="flex items-center gap-3">
			<%= f.range_field :rating, min: 0, max: 10, step: 0.1, value: f.object.rating || 5 ,
					oninput: "document.getElementById('rating-out').textContent = this.value",
					class: "flex-1" %>
			<span id="rating-out" class="text-sm fint-medium w-10 text-right"><%= f.object.rating || 5 %></span>
		</div>
	</div>

	<div class="mb-6 md:max-w-xs">
		<%= f.label :watched_day, "鑑賞日時", class: "block text-sm text-stone-600 mb-1" %>
		<%= f.date_field :watched_day, 
				class: "w-full border border-stone-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 fpcus:ring-amber-900"%>
	</div>

	<%= f.submit submit_label,
			class: "w-full md:w-auto bg-amber-900 text-white px-6 py-2 rounded-md font-medium hover:bg-amber-800 transition-colors cursor-pointer" %>
<% end %>